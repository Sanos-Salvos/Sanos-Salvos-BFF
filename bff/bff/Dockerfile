FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

ENV PORT=8083

ENV ORGANIZACIONES_HOST=localhost
ENV PET_HOST=localhost
ENV COINCIDENCIAS_HOST=localhost
ENV GEOLOCALIZACION_HOST=localhost
ENV NOTIFICACIONES_HOST=localhost
ENV AUTH_HOST=localhost


ENV ORGANIZACIONES_PORT=8081
ENV PET_PORT=8082
ENV COINCIDENCIAS_PORT=8084
ENV GEOLOCALIZACION_PORT=8085
ENV NOTIFICACIONES_PORT=8086
ENV AUTH_PORT=8088



EXPOSE 8083
ENTRYPOINT ["java", "-jar", "app.jar"]